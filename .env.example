# =============================================================================
# NO MO CO. — environment variables
# =============================================================================
# 1. Copy this file to a new file named exactly ".env"          cp .env.example .env
# 2. Fill in the values from the Firebase Console:
#      Project settings (gear icon) -> General -> Your apps -> Web app -> Config
# 3. Restart `npm run dev` after any change. Vite only reads .env at startup.
#
# These values are NOT secrets. Firebase web config is public by design; your
# data is protected by firestore.rules, not by hiding these keys.
# =============================================================================

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Business contact details shown on the Contact page.
VITE_CONTACT_PHONE=(920) 555-0134
VITE_CONTACT_EMAIL=hello@nomoco.com

# Stripe. Leave as false until you have deployed the Cloud Function in
# /functions (that requires the Firebase Blaze plan). While this is false the
# app shows a "pay your mower directly" message instead of a checkout button.
VITE_STRIPE_ENABLED=false
