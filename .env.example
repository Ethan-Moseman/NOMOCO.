# =============================================================================
# NO MO CO. — environment variables
# =============================================================================
# 1. Copy this file to a new file named exactly ".env"          cp .env.example .env
# 2. Fill in the values from the Firebase Console:
#      Project settings (gear icon) -> General -> Your apps -> Web app -> Config
# 3. Restart `npm run dev` after any change. Vite only reads .env at startup.
#
# These values are NOT secrets. Firebase web config is public by design; your
# data is protected by firestore.rules, not by hiding these keys.
# =============================================================================

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Business contact details shown on the Contact page and in the footer.
# These same values are the built-in defaults in src/lib/constants.js, so you
# only need these lines if you want to override them (a test build, say).
VITE_CONTACT_PHONE=(920) 636-3208
VITE_CONTACT_EMAIL=apolomassingue@gmail.com

# Photo uploads. Firebase now requires the paid Blaze plan for Cloud Storage
# on new projects, so this is off by default and the upload boxes are hidden.
# The rest of the site works exactly the same without it. To turn photos on:
# enable Storage in the Console, deploy storage.rules, set this to true.
VITE_ENABLE_PHOTOS=false

# Stripe. Leave as false until you have deployed the Cloud Function in
# /functions (that requires the Firebase Blaze plan). While this is false the
# app shows a "pay your mower directly" message instead of a checkout button.
VITE_STRIPE_ENABLED=false
